<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UserSecretsId>familygraph-server</UserSecretsId>
    </PropertyGroup>

    <!-- SPA Proxy: local development only. It is activated by ASPNETCORE_HOSTINGSTARTUPASSEMBLIES in launchSettings.json. -->
    <PropertyGroup>
        <SpaRoot>..\client</SpaRoot>
        <SpaProxyLaunchCommand>npm start</SpaProxyLaunchCommand>
        <SpaProxyServerUrl>https://localhost:4200</SpaProxyServerUrl>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Google.Apis.Auth" Version="1.77.0"/>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12"/>
        <PackageReference Include="Microsoft.AspNetCore.SpaProxy" Version="10.0.12"/>
        <!-- Design time only: lets dotnet ef use Server as the startup project, so it reads the Database section. -->
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.4">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <!-- The Client's translations (D-047), read at startup from the output folder. -->
    <ItemGroup>
        <Content Update="Translations\*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\FamilyGraph.Application\FamilyGraph.Application.csproj"/>
        <ProjectReference Include="..\FamilyGraph.Infrastructure\FamilyGraph.Infrastructure.csproj"/>
    </ItemGroup>

</Project>
